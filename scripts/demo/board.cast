[0.4, "o", "\u001b[2A\u001b[36m\u001b[1m\u001b[4mRunning\u001b(B\u001b[m\u001b[K\r\n\u001b[7m  TASK-1    \u001b[34mmyapp\u001b(B\u001b[m  Parser drops the trailing flag on repa\u2026 dev              \u001b[2m12m / 45m\u001b(B\u001b[m\u001b[K\r\n  TASK-2    \u001b[34mmyapp\u001b[39m  Rate limit the import job               \u001b[33mops paused\u001b[39m       \u001b[33mstale 4h30m / 60m\u001b[39m\u001b[K\u001b[7;1H\u001b[1m\u001b[4mTo\u001b(B\u001b[m\u001b[4m \u001b[1mDo\u001b(B\u001b[m\u001b[K\r\n  TASK-4    \u001b[34mmyapp\u001b[39m  Drop the legacy --json compact mode     \u001b[2m-\u001b(B\u001b[m                \u001b[2mlast run done Sun 12:48\u001b(B\u001b[m\u001b[K\r\n  TASK-3    \u001b[34mmyapp\u001b[39m  Spike: swap the CSV reader for a strea\u2026 \u001b[2m-\u001b(B\u001b[m                \u001b[K\r\n  TASK-3    \u001b[35mops\u001b[39m    Rotate the deploy keys                  \u001b[33mops paused\u001b[39m       \u001b[K\u001b[12;1H\u001b[33m\u001b[1m\u001b[4mBlocked\u001b(B\u001b[m\u001b[K\r\n  TASK-1    \u001b[35mops\u001b[39m    Pin the base image digest in the Docke\u2026 \u001b[33mops paused\u001b[39m       \u001b[K\u001b[15;1H\u001b[32m\u001b[1m\u001b[4mDone\u001b(B\u001b[m\u001b[K\r\n  TASK-5    \u001b[34mmyapp\u001b[39m  Document the retry policy               \u001b[2m-\u001b(B\u001b[m                \u001b[K\r\n  TASK-2    \u001b[35mops\u001b[39m    Retire the 2023 runbooks                \u001b[33mops paused\u001b[39m       \u001b[2mlast run done Mon 09:48\u001b(B\u001b[m\u001b[K\u001b[19;1H\u001b[2mj/k move \u00b7 r run \u00b7 x stop \u00b7 enter jump \u00b7 v read \u00b7 s assign \u00b7 a add \u00b7 / search \u00b7 g agents \u00b7 q quit\u001b(B\u001b[m\u001b[K\r"]
[3.967, "o", "\u001b[4d  TASK-1    \u001b[34mmyapp\u001b[39m  Parser drops the trailing flag on repa\u2026 dev              \u001b[2m12m / 45m\u001b(B\u001b[m\u001b[K\r\n\u001b[7m  TASK-2    \u001b[34mmyapp\u001b(B\u001b[m  Rate limit the import job               \u001b[33mops paused\u001b[39m       \u001b[33mstale 4h30m / 60m\u001b[39m\u001b[K\u001b[19;1H"]
[0.057, "o", "\u001b[?7727h\u001b(B\u001b[m\u001b[?12l\u001b[?25h\u001b[?1006l\u001b[?1000l\u001b[?1002l\u001b[?1003l\u001b[1;1H\u001b[1;22r\u001b[19;1H\u001b[?25l\u001b[H \u001b[1mfleet \u2014 /tmp/herdr-docket-demo/fleet\u001b(B\u001b[m\u001b[K\r\n\u001b[K\u001b[36m\u001b[1m\u001b[4m\r\nRunning\u001b(B\u001b[m\u001b[K\r\n  TASK-1    \u001b[34mmyapp\u001b[39m  Parser drops the trailing flag on repa\u2026 dev\u001b[14X\u001b[2m\u001b[14C12m / 45m\u001b(B\u001b[m\u001b[K\u001b[7m\r\n  TASK-2    \u001b[34mmyapp\u001b(B\u001b[m  Rate limit the import job\u001b[15X\u001b[33m\u001b[15Cops paused\u001b[39m       \u001b[33mstale 4h30m / 60m\u001b[39m\u001b[K\r\n\u001b[K\u001b[1m\u001b[4m\r\nTo\u001b(B\u001b[m\u001b[4m \u001b[1mDo\u001b(B\u001b[m\u001b[K\r\n  TASK-4    \u001b[34mmyapp\u001b[39m  Drop the legacy --json compact mode     \u001b[2m-\u001b(B\u001b[m\u001b[16X\u001b[2m\u001b[16Clast run done Sun 12:48\u001b(B\u001b[m         \u001b[9;1H  TASK-3    \u001b[34mmyapp\u001b[39m  Spike: swap the CSV reader for a strea\u2026 \u001b[2m-\u001b(B\u001b[m\u001b[K\r\n  TASK-3    \u001b[35mops\u001b[39m    Rotate the deploy keys\u001b[18X\u001b[33m\u001b[18Cops paused\u001b[39m\u001b[K\r\n\u001b[K\u001b[33m\u001b[1m\u001b[4m\r\nBlocked\u001b(B\u001b[m\u001b[K\r\n  TASK-1    \u001b[35mops\u001b[39m    Pin the base image digest in the Docke\u2026 \u001b[33mops paused\u001b[39m\u001b[K\r\n\u001b[K\u001b[32m\u001b[1m\u001b[4m\r\nDone\u001b(B\u001b[m\u001b[K\r\n  TASK-5    \u001b[34mmyapp\u001b[39m  Document the retry policy\u001b[15X\u001b[2m\u001b[15C-\u001b(B\u001b[m\u001b[K\r\n  TASK-2    \u001b[35mops\u001b[39m    Retire the 2023 runbooks\u001b[16X\u001b[33m\u001b[16Cops paused\u001b[39m       \u001b[2mlast run done Mon 09:48\u001b(B\u001b[m         \u001b[18;1H\u001b[K\u001b[2m\r\nj/k move \u00b7 r run \u00b7 x stop \u00b7 enter jump \u00b7 v read \u00b7 s assign \u00b7 a add \u00b7 / search \u00b7 g agents \u00b7 q quit\u001b(B\u001b[m\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u0