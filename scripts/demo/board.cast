[1.359, "o", "\u001b[4d\u001b[7m  TASK-1    \u001b[34mmyapp\u001b(B\u001b[m  Parser drops the trailing flag on repa\u2026 dev              \u001b[2m12m / 45m\u001b(B\u001b[m\u001b[K\r\n  TASK-2    \u001b[34mmyapp\u001b[39m  Rate limit the import job               \u001b[33mops paused\u001b[39m       \u001b[33mstale 4h30m / 60m\u001b[39m\u001b[K\u001b[19;1H"]
[3.402, "o", "\u001b[3dmyapp/TASK-1 \u2014 Parser drops the trailing flag on reparse\u001b[K\r\nopen \u00b7 In Progress \u00b7 dev\u001b[K\r\n\u001b[K\r\n\u001b[2mj/k scroll \u00b7 esc board \u00b7 g agents \u00b7 q quit\u001b(B\u001b[m\u001b[K\r\n\u001b[J\u001b[6;43H\u001b[K\r"]
[0.465, "o", "## Description\u001b[K\u001b[8;1HRepro: `myapp parse --x` loses --x when the file is re-read.\u001b[K\u001b[10;1H## Notes\u001b[K\u001b[12;1HSuspect the flag table is rebuilt from the short names alone.\u001b[K\u001b[14;1H\u001b[2mj/k scroll \u00b7 esc board \u00b7 g agents \u00b7 q quit\u001b(B\u001b[m\u001b[K\r"]
[3.801, "o", "\u001b[3d\u001b[36m\u001b[1m\u001b[4mRunning\u001b(B\u001b[m\u001b[K\r\n\u001b[7m  TASK-1    \u001b[34mmyapp\u001b(B\u001b[m  Parser drops the trailing flag on repa\u2026 dev              \u001b[2m12m / 45m\u001b(B\u001b[m\u001b[K\r\n  TASK-2    \u001b[34mmyapp\u001b[39m  Rate limit the import job               \u001b[33mops paused\u001b[39m       \u001b[33mstale 4h30m / 60m\u001b[39m\u001b[K\r\n\u001b[K\r\n\u001b[1m\u001b[4mTo\u001b(B\u001b[m\u001b[4m \u001b[1mDo\u001b(B\u001b[m\u001b[K\r\n  TASK-4    \u001b[34mmyapp\u001b[39m  Drop the legacy --json compact mode     \u001b[2m-\u001b(B\u001b[m                \u001b[2mlast run done Sun 12:48\u001b(B\u001b[m\u001b[K\r\n  TASK-3    \u001b[34mmyapp\u001b[39m  Spike: swap the CSV reader for a strea\u2026 \u001b[2m-\u001b(B\u001b[m                \u001b[K\r\n  TASK-3    \u001b[35mops\u001b[39m    Rotate the deploy keys                  \u001b[33mops paused\u001b[39m       \u001b[K\u001b[12;1H\u001b[33m\u001b[1m\u001b[4mBlocked\u001b(B\u001b[m\u001b[K\r\n  TASK-1    \u001b[35mops\u001b[39m    Pin the base image digest in the Docke\u2026 \u001b[33mops paused\u001b[39m       \u001b[K\r\n\u001b[K\r\n\u001b[32m\u001b[1m\u001b[4mDone\u001b(B\u001b[m\u001b[K\r\n  TASK-5    \u001b[34mmyapp\u001b[39m  Document the retry policy               \u001b[2m-\u001b(B\u001b[m                \u001b[K\r\n  TASK-2    \u001b[35mops\u001b[39m    Retire the 2023 runbooks                \u001b[33mops paused\u001b[39m       \u001b[2mlast run done Mon 09:48\u001b(B\u001b[m\u001b[K\u001b[19;1H\u001b[2mj/k move \u00b7 r run \u00b7 x stop \u00b7 enter jump \u00b7 v read \u00b7 s assign \u00b7 a add \u00b7 / search \u00b7 g agents \u00b7 q quit\u001b(B\u001b[m\u001b[K\r"]
[3.016, "o", "\u001b[H \u001b[1mfleet agents \u2014 /tmp/herdr-docket-demo/fleet\u001b(B\u001b[m \u001b[K\u001b[3;1H\u001b[7m  dev              claude     claude-sonnet-5          worktree  \u001b[32menabled\u001b(B\u001b[m  \u001b[36m\u001b[1mbusy\u001b(B\u001b[m \u001b[2m12m / 45m\u001b(B\u001b[m TASK-1 myapp Parse\u2026\u001b[4;1H  example          claude                              root      \u001b[32menabled\u001b[39m  \u001b[36m\u001b[1mbusy\u001b(B\u001b[m \u001b[33mstale 4h30m / 60m\u001b[39m TASK-2 mya\u2026\u001b[5;1H  ops              claude     claude-sonnet-5          root      \u001b[33mdisabled\u001b[39m  \u001b[2midle\u001b(B\u001b[m\u001b[K\u001b[7;1H\u001b[2mj/k move \u00b7 p pause/resume \u00b7 g board \u00b7 q quit\u001b(B\u001b[m\u001b[K\r\n\u001b[J\u001b[7;45H\u001b[K\r"]
[3.017, "o", "\r\n\u001b[33mdev paused \u2014 a run already in flight keeps going; x stops it\u001b[39m\u001b[K\r"]
